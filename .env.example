# ---------------------------------------------------------------------------
# DeutschLern AI — environment configuration
# The server reads PORT, NODE_ENV, the AI variables, the optional speech
# variables and the Milestone 7 auth variables from the process environment.
# Copy this file to .env for local development. `npm start` and `npm run dev`
# load .env server-side through server/env-loader.js; values already present in
# the shell or process manager take precedence. .env is gitignored. Tests and
# `npm run verify` deliberately ignore it. NEVER commit real keys or put any of
# these values in frontend code.
# ---------------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=3000

# Reverse proxy setup ONLY. Leave unset/false when Node is exposed directly:
# forwarded headers are ignored and rate limits key on the socket peer.
# Set 1 for one trusted hop, an integer for N hops, or (preferred for a local
# cloudflared tunnel) a comma-separated list of trusted proxy IPs/CIDRs such as
# 127.0.0.1,::1. A list ignores forwarded headers from every other peer.
# Boolean true is rejected because it would trust every forwarded hop.
# Cloudflare Tunnel requests from a trusted loopback proxy are additionally
# keyed by CF-Connecting-IP.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# AI provider (Milestone 5 — server-side only)
# ---------------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional alternative provider (OpenAI-compatible endpoints)
# AI_PROVIDER=compatible
# AI_BASE_URL=https://api.example.com/v1
# AI_API_KEY=
# AI_MODEL=

# ---------------------------------------------------------------------------
# Speech provider (Milestone 6 — only if the browser Speech API is not enough)
# ---------------------------------------------------------------------------
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# ---------------------------------------------------------------------------
# Accounts & sync (Milestone 7 — server-side only)
# ---------------------------------------------------------------------------
# Required in production (at least 32 characters). A long random value used to
# sign session cookies, e.g. `openssl rand -base64 48`. A shorter value is
# rejected just like a missing one. In development this is generated and
# persisted at DATA_DIR/dev-session-secret. Without a valid value in production,
# /api/auth/status reports configured: false and account routes return 503.
SESSION_SECRET=

# Reserved for a future token adapter. Current sessions are opaque server-side
# records with a signed cookie; JWTs are NOT used.
JWT_SECRET=

# Directory for deutschlern-db.json and the generated development secret.
# Default: ./data
DATA_DIR=

# Development only. When true, password-reset tokens are returned in the API
# response so the flow can be tested without an email provider. Never enable
# this in production.
ALLOW_DEV_RESET_TOKENS=false

# The built-in database is a self-hosted atomic JSON file, so no external
# DATABASE_URL/SUPABASE credentials are required for accounts or sync.

# ---------------------------------------------------------------------------
# Rate limits (Milestone 9 — server-side only, safe defaults shown)
# Every writable API has a bounded in-memory sliding window per client IP.
# Invalid values are ignored. Counters reset when the process restarts.
# ---------------------------------------------------------------------------
RATE_AI_WINDOW_MS=60000
RATE_AI_MAX=20
RATE_SPEECH_WINDOW_MS=60000
RATE_SPEECH_MAX=12
RATE_AUTH_WINDOW_MS=900000
RATE_REGISTER_MAX=20
RATE_LOGIN_MAX=30
RATE_PASSWORD_MAX=10
RATE_ACCOUNT_DELETE_MAX=5
RATE_SYNC_WINDOW_MS=60000
RATE_SYNC_WRITE_MAX=60
